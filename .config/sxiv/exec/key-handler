#!/usr/bin/env bash

while read file
do
    fullpath=$(readlink -fn "$file")
    case "$1" in
        "C-d")
            mv "$fullpath" ~/.trash/ ;;
        "C-c")
            wl-copy < "$fullpath" ;;
        "C-r")
            convert "$fullpath" -rotate 90 "$fullpath" ;;
        "C-w")
            setWallpaper "$fullpath" & ;;
    esac
done
