font-family = "Aporetic Sans Mono"
font-size = 14.0
theme = Rose Pine Dawn
background-opacity = 1.0
background-blur = 10
# window-decoration = none
window-padding-x = 24
window-padding-y = 24
# window-show-tab-bar = never
shell-integration = zsh
shell-integration-features = no-cursor
cursor-style = block