#!/usr/bin/env bash

FOLDERWALLPAPERS=$(xdg-user-dir PICTURES)/Wallpapers
LOCKWALLPAPER=/tmp/lockwallpaper.png

echo $FOLDERWALLPAPERS

function randomWallpaper {
    # echo "$(find ~/*/Wallpapers/* -type f | shuf -n 1)"
    echo $(perl -e '@f=</home/lean/Pictures/Wallpapers/*>; if(@f){ chomp($r = $f[rand @f]); print "$r\n" }')
}

function getLockWallpaer {
    convert "$1" -scale 10% -blur 0x2.5 -resize 1000% "$LOCKWALLPAPER"
}

function getWallpaper {
    if ! [ -z $1 ]
    then
        local wallpaper=$(realpath "$1")
    else    
        local wallpaper=$(randomWallpaper)
    fi
    echo $wallpaper
}

WALLPAPER="$(getWallpaper $1)"

PID=$(pgrep -x swaybg)

swaybg -m fill -i "$WALLPAPER" &

if [ $PID ]; then
    sleep 0.5
    kill $PID
fi

exit 0
