#!/usr/bin/env bash

export XDG_RUNTIME_DIR=/run/user/$(id -u)
export WAYLAND_DISPLAY=wayland-1

LOCKWALLPAPER=/tmp/lockwallpaper.png

function randomWallpaper {
    echo "$(find ~/*/Wallpapers/* -type f | shuf -n 1)"
}

function getLockWallpaer {
    magick "$1" -scale 10% -blur 0x2.5 -resize 1000% "$LOCKWALLPAPER"
}

function getWallpaper {
    if ! [ -z $1 ]
    then
        local wallpaper=$(realpath "$1")
    else    
        local wallpaper=$(randomWallpaper)
    fi
    echo $wallpaper
}

function loadWallpaper {
    local wallpaper=$1
    local namespace=$2

    local ARGS="-t any"
    local MSG="Load wallpaper: $WALLPAPER"

    if [[ "$namespace" ]]
    then
        ARGS="$ARGS -n $namespace"
        MSG="$MSG, namespace: $namespace"
    fi
    
    if [ -f $wallpaper ]
    then
        local COMMAND="awww img ${wallpaper} ${ARGS}"
        $COMMAND
    else
        exit 1
    fi    
}

WALLPAPER="$(getWallpaper $1)"

getLockWallpaer "$WALLPAPER" &

loadWallpaper "$WALLPAPER" "default" &&
    echo "Load wallpapper: $WALLPAPER to namespace: default"

wait
loadWallpaper "$LOCKWALLPAPER" "overlay" &&
    echo "Load lock wallpapper: $LOCKWALLPAPER to namespace: overlay"
    
notify-send -t 3000 "Change Wallpapers"

exit 0
